(declare-datatypes ((DATE 0)) (((mk-date (day Int) (month Int) (year Int)))))

(declare-fun ltDate (DATE DATE) Bool)
(declare-fun gtDate (DATE DATE) Bool)
(declare-fun eqDate (DATE DATE) Bool)

(assert (forall ((d1 DATE) (d2 DATE))
  (let ((a!1 (or (< (year d1) (year d2))
                 (and (= (year d1) (year d2)) (< (month d1) (month d2)))
                 (and (= (year d1) (year d2))
                      (= (month d1) (month d2))
                      (< (day d1) (day d2))))))
    (= (ltDate d1 d2) a!1))))
    
(assert (forall ((d1 DATE) (d2 DATE))
  (let ((a!1 (or (> (year d1) (year d2))
                 (and (= (year d1) (year d2)) (> (month d1) (month d2)))
                 (and (= (year d1) (year d2))
                      (= (month d1) (month d2))
                      (> (day d1) (day d2))))))
    (= (gtDate d1 d2) a!1))))
    
(assert (forall ((d1 DATE) (d2 DATE))
  (= (eqDate d1 d2)
     (and (= (year d1) (year d2))
          (= (month d1) (month d2))
          (= (day d1) (day d2))))))

