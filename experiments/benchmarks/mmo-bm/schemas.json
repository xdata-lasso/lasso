    "ddl_postgres": "/* Relational schema for MMO-BM (ManyMutationsObfuscated: Faker Words) */ /* Relational schema for ManyMutantsBM benchmark suite. */ /* Universal schema compatible with SQLite, PostgreSQL, and MySQL. */ CREATE TABLE purpose (performance INT PRIMARY KEY, knowledge VARCHAR(100) NOT NULL UNIQUE, almost VARCHAR(100) NOT NULL);\nCREATE TABLE brother (better INT PRIMARY KEY, discover VARCHAR(100) NOT NULL, performance INT NOT NULL, early VARCHAR(50) NOT NULL, mouth INT NOT NULL DEFAULT 1, FOREIGN KEY (performance) REFERENCES purpose (performance));\nCREATE TABLE site (play INT PRIMARY KEY, agreement VARCHAR(100) NOT NULL UNIQUE, performance INT NOT NULL, option REAL NOT NULL, decide VARCHAR(20) NOT NULL, FOREIGN KEY (performance) REFERENCES purpose (performance));\nCREATE TABLE face (sense INT PRIMARY KEY, better INT NOT NULL, play INT NOT NULL, rate VARCHAR(20) NOT NULL, science REAL NOT NULL, UNIQUE (better, play), FOREIGN KEY (better) REFERENCES brother (better), FOREIGN KEY (play) REFERENCES site (play));\nCREATE TABLE election (kind INT PRIMARY KEY, play INT NOT NULL, discussion INT, early VARCHAR(200) NOT NULL, perform VARCHAR(20) NOT NULL, decide VARCHAR(20) NOT NULL, fall VARCHAR(20) NOT NULL, FOREIGN KEY (play) REFERENCES site (play), FOREIGN KEY (discussion) REFERENCES brother (better));\nCREATE TABLE chair (according INT PRIMARY KEY, song VARCHAR(100) NOT NULL, sure VARCHAR(20) NOT NULL, mouth INT NOT NULL DEFAULT 1);\nCREATE TABLE since (collection INT PRIMARY KEY, according INT NOT NULL, save VARCHAR(20) NOT NULL, grow VARCHAR(20) NOT NULL, clearly VARCHAR(20) NOT NULL DEFAULT 'STANDARD', dinner REAL NOT NULL DEFAULT 0, FOREIGN KEY (according) REFERENCES chair (according));\nCREATE TABLE blue (source INT PRIMARY KEY, great VARCHAR(100) NOT NULL UNIQUE, best VARCHAR(50) NOT NULL);\nCREATE TABLE require (husband INT PRIMARY KEY, source INT NOT NULL, bill VARCHAR(100) NOT NULL, throw REAL NOT NULL, everything INT NOT NULL DEFAULT 0, FOREIGN KEY (source) REFERENCES blue (source));\nCREATE TABLE wait (surface INT PRIMARY KEY, collection INT NOT NULL, husband INT NOT NULL, animal INT NOT NULL, machine REAL NOT NULL, capital REAL, UNIQUE (collection, husband), FOREIGN KEY (collection) REFERENCES since (collection), FOREIGN KEY (husband) REFERENCES require (husband));\nCREATE TABLE offer (human INT PRIMARY KEY, husband INT NOT NULL, according INT NOT NULL, finally INT NOT NULL, themselves INT NOT NULL DEFAULT 0, production VARCHAR(20) NOT NULL, FOREIGN KEY (husband) REFERENCES require (husband), FOREIGN KEY (according) REFERENCES chair (according));",
