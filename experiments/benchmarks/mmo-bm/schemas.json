    "spotit_ddl": "CREATE TABLE \"PURPOSE\" (\n    \"PERFORMANCE\" INT,\n    \"KNOWLEDGE\" TEXT NOT NULL,\n    \"ALMOST\" TEXT NOT NULL,\n    PRIMARY KEY (\"PERFORMANCE\"),\n    UNIQUE (\"KNOWLEDGE\")\n);\nCREATE TABLE \"BROTHER\" (\n    \"BETTER\" INT,\n    \"DISCOVER\" TEXT NOT NULL,\n    \"PERFORMANCE\" INT NOT NULL,\n    \"EARLY\" TEXT NOT NULL,\n    \"MOUTH\" INT NOT NULL,\n    PRIMARY KEY (\"BETTER\"),\n    FOREIGN KEY (\"PERFORMANCE\") REFERENCES \"PURPOSE\"(\"PERFORMANCE\")\n);\nCREATE TABLE \"SITE\" (\n    \"PLAY\" INT,\n    \"AGREEMENT\" TEXT NOT NULL,\n    \"PERFORMANCE\" INT NOT NULL,\n    \"OPTION\" FLOAT NOT NULL,\n    \"DECIDE\" TEXT NOT NULL,\n    PRIMARY KEY (\"PLAY\"),\n    UNIQUE (\"AGREEMENT\"),\n    FOREIGN KEY (\"PERFORMANCE\") REFERENCES \"PURPOSE\"(\"PERFORMANCE\")\n);\nCREATE TABLE \"FACE\" (\n    \"SENSE\" INT,\n    \"BETTER\" INT NOT NULL,\n    \"PLAY\" INT NOT NULL,\n    \"RATE\" TEXT NOT NULL,\n    \"SCIENCE\" FLOAT NOT NULL,\n    PRIMARY KEY (\"SENSE\"),\n    UNIQUE (\"BETTER\", \"PLAY\"),\n    FOREIGN KEY (\"BETTER\") REFERENCES \"BROTHER\"(\"BETTER\"),\n    FOREIGN KEY (\"PLAY\") REFERENCES \"SITE\"(\"PLAY\")\n);\nCREATE TABLE \"ELECTION\" (\n    \"KIND\" INT,\n    \"PLAY\" INT NOT NULL,\n    \"DISCUSSION\" INT,\n    \"EARLY\" TEXT NOT NULL,\n    \"PERFORM\" TEXT NOT NULL,\n    \"DECIDE\" TEXT NOT NULL,\n    \"FALL\" TEXT NOT NULL,\n    PRIMARY KEY (\"KIND\"),\n    FOREIGN KEY (\"PLAY\") REFERENCES \"SITE\"(\"PLAY\"),\n    FOREIGN KEY (\"DISCUSSION\") REFERENCES \"BROTHER\"(\"BETTER\")\n);\nCREATE TABLE \"CHAIR\" (\n    \"ACCORDING\" INT,\n    \"SONG\" TEXT NOT NULL,\n    \"SURE\" TEXT NOT NULL,\n    \"MOUTH\" INT NOT NULL,\n    PRIMARY KEY (\"ACCORDING\")\n);\nCREATE TABLE \"SINCE\" (\n    \"COLLECTION\" INT,\n    \"ACCORDING\" INT NOT NULL,\n    \"SAVE\" TEXT NOT NULL,\n    \"GROW\" TEXT NOT NULL,\n    \"CLEARLY\" TEXT NOT NULL,\n    \"DINNER\" FLOAT NOT NULL,\n    PRIMARY KEY (\"COLLECTION\"),\n    FOREIGN KEY (\"ACCORDING\") REFERENCES \"CHAIR\"(\"ACCORDING\")\n);\nCREATE TABLE \"BLUE\" (\n    \"SOURCE\" INT,\n    \"GREAT\" TEXT NOT NULL,\n    \"BEST\" TEXT NOT NULL,\n    PRIMARY KEY (\"SOURCE\"),\n    UNIQUE (\"GREAT\")\n);\nCREATE TABLE \"REQUIRE\" (\n    \"HUSBAND\" INT,\n    \"SOURCE\" INT NOT NULL,\n    \"BILL\" TEXT NOT NULL,\n    \"THROW\" FLOAT NOT NULL,\n    \"EVERYTHING\" INT NOT NULL,\n    PRIMARY KEY (\"HUSBAND\"),\n    FOREIGN KEY (\"SOURCE\") REFERENCES \"BLUE\"(\"SOURCE\")\n);\nCREATE TABLE \"WAIT\" (\n    \"SURFACE\" INT,\n    \"COLLECTION\" INT NOT NULL,\n    \"HUSBAND\" INT NOT NULL,\n    \"ANIMAL\" INT NOT NULL,\n    \"MACHINE\" FLOAT NOT NULL,\n    \"CAPITAL\" FLOAT,\n    PRIMARY KEY (\"SURFACE\"),\n    UNIQUE (\"COLLECTION\", \"HUSBAND\"),\n    FOREIGN KEY (\"COLLECTION\") REFERENCES \"SINCE\"(\"COLLECTION\"),\n    FOREIGN KEY (\"HUSBAND\") REFERENCES \"REQUIRE\"(\"HUSBAND\")\n);\nCREATE TABLE \"OFFER\" (\n    \"HUMAN\" INT,\n    \"HUSBAND\" INT NOT NULL,\n    \"ACCORDING\" INT NOT NULL,\n    \"FINALLY\" INT NOT NULL,\n    \"THEMSELVES\" INT NOT NULL,\n    \"PRODUCTION\" TEXT NOT NULL,\n    PRIMARY KEY (\"HUMAN\"),\n    FOREIGN KEY (\"HUSBAND\") REFERENCES \"REQUIRE\"(\"HUSBAND\"),\n    FOREIGN KEY (\"ACCORDING\") REFERENCES \"CHAIR\"(\"ACCORDING\")\n);",
