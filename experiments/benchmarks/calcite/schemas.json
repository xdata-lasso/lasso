    "ddl_postgres": "CREATE TABLE \"dept\" (\"deptno\" INT NOT NULL PRIMARY KEY, \"name\" TEXT(255) NOT NULL);\nCREATE TABLE \"emp\" (\"empno\" INT NOT NULL PRIMARY KEY, \"deptno\" INT NOT NULL, \"ename\" TEXT(255) NOT NULL, \"job\" TEXT(255) NOT NULL, \"mgr\" INT, \"hiredate\" DATE NOT NULL, \"sal\" INT NOT NULL, \"comm\" INT NOT NULL, \"slacker\" INT NOT NULL, FOREIGN KEY (\"deptno\") REFERENCES \"dept\" (\"deptno\"));\nCREATE TABLE \"bonus\" (\"ename\" TEXT(255) NOT NULL, \"job\" TEXT(255) NOT NULL, \"sal\" INT NOT NULL, \"comm\" INT NOT NULL);\nCREATE TABLE \"empnullables\" (\"empno\" INT PRIMARY KEY, \"deptno\" INT, \"ename\" TEXT(255), \"job\" TEXT(255), \"mgr\" INT, \"hiredate\" DATE, \"sal\" INT, \"comm\" INT, \"slacker\" INT, FOREIGN KEY (\"deptno\") REFERENCES \"dept\" (\"deptno\"));\nCREATE TABLE \"empnullables_20\" (\"empno\" INT PRIMARY KEY, \"deptno\" INT, \"ename\" TEXT(255), \"job\" TEXT(255), \"mgr\" INT, \"hiredate\" DATE, \"sal\" INT, \"comm\" INT, \"slacker\" INT, FOREIGN KEY (\"deptno\") REFERENCES \"dept\" (\"deptno\"));\nCREATE TABLE \"emp_b\" (\"empno\" INT NOT NULL PRIMARY KEY, \"deptno\" INT NOT NULL, \"ename\" TEXT(255) NOT NULL, \"job\" TEXT(255) NOT NULL, \"mgr\" INT, \"hiredate\" DATE NOT NULL, \"sal\" INT NOT NULL, \"comm\" INT NOT NULL, \"slacker\" INT NOT NULL, \"birthdate\" DATE NOT NULL, FOREIGN KEY (\"deptno\") REFERENCES \"dept\" (\"deptno\"));",
