    "spotit_ddl": "CREATE TABLE \"EMP\" (\n    \"EMPNO\" INT,\n    \"DEPTNO\" INT NOT NULL,\n    \"ENAME\" TEXT NOT NULL,\n    \"JOB\" TEXT NOT NULL,\n    \"MGR\" INT,\n    \"HIREDATE\" DATE NOT NULL,\n    \"SAL\" INT NOT NULL,\n    \"COMM\" INT NOT NULL,\n    \"SLACKER\" INT NOT NULL,\n    PRIMARY KEY (\"EMPNO\"),\n    FOREIGN KEY (\"DEPTNO\") REFERENCES \"DEPT\"(\"DEPTNO\")\n);\nCREATE TABLE \"DEPT\" (\n    \"DEPTNO\" INT,\n    \"NAME\" TEXT NOT NULL,\n    PRIMARY KEY (\"DEPTNO\")\n);\nCREATE TABLE \"BONUS\" (\n    \"ENAME\" TEXT NOT NULL,\n    \"JOB\" TEXT NOT NULL,\n    \"SAL\" INT NOT NULL,\n    \"COMM\" INT NOT NULL\n);\nCREATE TABLE \"EMPNULLABLES\" (\n    \"EMPNO\" INT,\n    \"DEPTNO\" INT,\n    \"ENAME\" TEXT,\n    \"JOB\" TEXT,\n    \"MGR\" INT,\n    \"HIREDATE\" DATE,\n    \"SAL\" INT,\n    \"COMM\" INT,\n    \"SLACKER\" INT,\n    PRIMARY KEY (\"EMPNO\"),\n    FOREIGN KEY (\"DEPTNO\") REFERENCES \"DEPT\"(\"DEPTNO\")\n);\nCREATE TABLE \"EMPNULLABLES_20\" (\n    \"EMPNO\" INT,\n    \"DEPTNO\" INT,\n    \"ENAME\" TEXT,\n    \"JOB\" TEXT,\n    \"MGR\" INT,\n    \"HIREDATE\" DATE,\n    \"SAL\" INT,\n    \"COMM\" INT,\n    \"SLACKER\" INT,\n    PRIMARY KEY (\"EMPNO\"),\n    FOREIGN KEY (\"DEPTNO\") REFERENCES \"DEPT\"(\"DEPTNO\")\n);\nCREATE TABLE \"EMP_B\" (\n    \"EMPNO\" INT,\n    \"DEPTNO\" INT NOT NULL,\n    \"ENAME\" TEXT NOT NULL,\n    \"JOB\" TEXT NOT NULL,\n    \"MGR\" INT,\n    \"HIREDATE\" DATE NOT NULL,\n    \"SAL\" INT NOT NULL,\n    \"COMM\" INT NOT NULL,\n    \"SLACKER\" INT NOT NULL,\n    \"BIRTHDATE\" DATE NOT NULL,\n    PRIMARY KEY (\"EMPNO\"),\n    FOREIGN KEY (\"DEPTNO\") REFERENCES \"DEPT\"(\"DEPTNO\")\n);",
