    "ddl_postgres": "/* Relational schema for MMRO-BM (ManyMutationsRandomObfuscated: Random Letter Strings) */ /* Relational schema for ManyMutantsBM benchmark suite. */ /* Universal schema compatible with SQLite, PostgreSQL, and MySQL. */ CREATE TABLE udaxih (utlsgw INT PRIMARY KEY, cbvhyj VARCHAR(100) NOT NULL UNIQUE, chdmio VARCHAR(100) NOT NULL);\nCREATE TABLE hexdvx (ulfllg INT PRIMARY KEY, viwvuc VARCHAR(100) NOT NULL, utlsgw INT NOT NULL, tufrxh VARCHAR(50) NOT NULL, fomiuw INT NOT NULL DEFAULT 1, FOREIGN KEY (utlsgw) REFERENCES udaxih (utlsgw));\nCREATE TABLE rcsnba (rhvkyy INT PRIMARY KEY, bhbzkm VARCHAR(100) NOT NULL UNIQUE, utlsgw INT NOT NULL, icgswk REAL NOT NULL, gupmuo VARCHAR(20) NOT NULL, FOREIGN KEY (utlsgw) REFERENCES udaxih (utlsgw));\nCREATE TABLE cghqta (eiehxr INT PRIMARY KEY, ulfllg INT NOT NULL, rhvkyy INT NOT NULL, rixsns VARCHAR(20) NOT NULL, mlheqp REAL NOT NULL, UNIQUE (ulfllg, rhvkyy), FOREIGN KEY (ulfllg) REFERENCES hexdvx (ulfllg), FOREIGN KEY (rhvkyy) REFERENCES rcsnba (rhvkyy));\nCREATE TABLE rgwuwr (cybdeu INT PRIMARY KEY, rhvkyy INT NOT NULL, fzvntc INT, tufrxh VARCHAR(200) NOT NULL, mmtoqi VARCHAR(20) NOT NULL, gupmuo VARCHAR(20) NOT NULL, ravxdv VARCHAR(20) NOT NULL, FOREIGN KEY (rhvkyy) REFERENCES rcsnba (rhvkyy), FOREIGN KEY (fzvntc) REFERENCES hexdvx (ulfllg));\nCREATE TABLE nhosiz (ryiyuk INT PRIMARY KEY, djnfoa VARCHAR(100) NOT NULL, xxiqyf VARCHAR(20) NOT NULL, fomiuw INT NOT NULL DEFAULT 1);\nCREATE TABLE ayzfwn (qdujuq INT PRIMARY KEY, ryiyuk INT NOT NULL, tgelyf VARCHAR(20) NOT NULL, ryqatk VARCHAR(20) NOT NULL, padlzj VARCHAR(20) NOT NULL DEFAULT 'STANDARD', hbhscc REAL NOT NULL DEFAULT 0, FOREIGN KEY (ryiyuk) REFERENCES nhosiz (ryiyuk));\nCREATE TABLE kiegyk (xpcyry INT PRIMARY KEY, eevprf VARCHAR(100) NOT NULL UNIQUE, iqtngr VARCHAR(50) NOT NULL);\nCREATE TABLE dcmdll (yxwgwj INT PRIMARY KEY, xpcyry INT NOT NULL, mvuloq VARCHAR(100) NOT NULL, odhhck REAL NOT NULL, asrhsh INT NOT NULL DEFAULT 0, FOREIGN KEY (xpcyry) REFERENCES kiegyk (xpcyry));\nCREATE TABLE tizbxo (acwubh INT PRIMARY KEY, qdujuq INT NOT NULL, yxwgwj INT NOT NULL, cbkcqh INT NOT NULL, ivpgre REAL NOT NULL, xssphz REAL, UNIQUE (qdujuq, yxwgwj), FOREIGN KEY (qdujuq) REFERENCES ayzfwn (qdujuq), FOREIGN KEY (yxwgwj) REFERENCES dcmdll (yxwgwj));\nCREATE TABLE rdmcrj (pzngdd INT PRIMARY KEY, yxwgwj INT NOT NULL, ryiyuk INT NOT NULL, vnlnno INT NOT NULL, xbvuud INT NOT NULL DEFAULT 0, bmxkzd VARCHAR(20) NOT NULL, FOREIGN KEY (yxwgwj) REFERENCES dcmdll (yxwgwj), FOREIGN KEY (ryiyuk) REFERENCES nhosiz (ryiyuk));",
