    "spotit_ddl": "CREATE TABLE \"UDAXIH\" (\n    \"UTLSGW\" INT,\n    \"CBVHYJ\" TEXT NOT NULL,\n    \"CHDMIO\" TEXT NOT NULL,\n    PRIMARY KEY (\"UTLSGW\"),\n    UNIQUE (\"CBVHYJ\")\n);\nCREATE TABLE \"HEXDVX\" (\n    \"ULFLLG\" INT,\n    \"VIWVUC\" TEXT NOT NULL,\n    \"UTLSGW\" INT NOT NULL,\n    \"TUFRXH\" TEXT NOT NULL,\n    \"FOMIUW\" INT NOT NULL,\n    PRIMARY KEY (\"ULFLLG\"),\n    FOREIGN KEY (\"UTLSGW\") REFERENCES \"UDAXIH\"(\"UTLSGW\")\n);\nCREATE TABLE \"RCSNBA\" (\n    \"RHVKYY\" INT,\n    \"BHBZKM\" TEXT NOT NULL,\n    \"UTLSGW\" INT NOT NULL,\n    \"ICGSWK\" FLOAT NOT NULL,\n    \"GUPMUO\" TEXT NOT NULL,\n    PRIMARY KEY (\"RHVKYY\"),\n    UNIQUE (\"BHBZKM\"),\n    FOREIGN KEY (\"UTLSGW\") REFERENCES \"UDAXIH\"(\"UTLSGW\")\n);\nCREATE TABLE \"CGHQTA\" (\n    \"EIEHXR\" INT,\n    \"ULFLLG\" INT NOT NULL,\n    \"RHVKYY\" INT NOT NULL,\n    \"RIXSNS\" TEXT NOT NULL,\n    \"MLHEQP\" FLOAT NOT NULL,\n    PRIMARY KEY (\"EIEHXR\"),\n    UNIQUE (\"ULFLLG\", \"RHVKYY\"),\n    FOREIGN KEY (\"ULFLLG\") REFERENCES \"HEXDVX\"(\"ULFLLG\"),\n    FOREIGN KEY (\"RHVKYY\") REFERENCES \"RCSNBA\"(\"RHVKYY\")\n);\nCREATE TABLE \"RGWUWR\" (\n    \"CYBDEU\" INT,\n    \"RHVKYY\" INT NOT NULL,\n    \"FZVNTC\" INT,\n    \"TUFRXH\" TEXT NOT NULL,\n    \"MMTOQI\" TEXT NOT NULL,\n    \"GUPMUO\" TEXT NOT NULL,\n    \"RAVXDV\" TEXT NOT NULL,\n    PRIMARY KEY (\"CYBDEU\"),\n    FOREIGN KEY (\"RHVKYY\") REFERENCES \"RCSNBA\"(\"RHVKYY\"),\n    FOREIGN KEY (\"FZVNTC\") REFERENCES \"HEXDVX\"(\"ULFLLG\")\n);\nCREATE TABLE \"NHOSIZ\" (\n    \"RYIYUK\" INT,\n    \"DJNFOA\" TEXT NOT NULL,\n    \"XXIQYF\" TEXT NOT NULL,\n    \"FOMIUW\" INT NOT NULL,\n    PRIMARY KEY (\"RYIYUK\")\n);\nCREATE TABLE \"AYZFWN\" (\n    \"QDUJUQ\" INT,\n    \"RYIYUK\" INT NOT NULL,\n    \"TGELYF\" TEXT NOT NULL,\n    \"RYQATK\" TEXT NOT NULL,\n    \"PADLZJ\" TEXT NOT NULL,\n    \"HBHSCC\" FLOAT NOT NULL,\n    PRIMARY KEY (\"QDUJUQ\"),\n    FOREIGN KEY (\"RYIYUK\") REFERENCES \"NHOSIZ\"(\"RYIYUK\")\n);\nCREATE TABLE \"KIEGYK\" (\n    \"XPCYRY\" INT,\n    \"EEVPRF\" TEXT NOT NULL,\n    \"IQTNGR\" TEXT NOT NULL,\n    PRIMARY KEY (\"XPCYRY\"),\n    UNIQUE (\"EEVPRF\")\n);\nCREATE TABLE \"DCMDLL\" (\n    \"YXWGWJ\" INT,\n    \"XPCYRY\" INT NOT NULL,\n    \"MVULOQ\" TEXT NOT NULL,\n    \"ODHHCK\" FLOAT NOT NULL,\n    \"ASRHSH\" INT NOT NULL,\n    PRIMARY KEY (\"YXWGWJ\"),\n    FOREIGN KEY (\"XPCYRY\") REFERENCES \"KIEGYK\"(\"XPCYRY\")\n);\nCREATE TABLE \"TIZBXO\" (\n    \"ACWUBH\" INT,\n    \"QDUJUQ\" INT NOT NULL,\n    \"YXWGWJ\" INT NOT NULL,\n    \"CBKCQH\" INT NOT NULL,\n    \"IVPGRE\" FLOAT NOT NULL,\n    \"XSSPHZ\" FLOAT,\n    PRIMARY KEY (\"ACWUBH\"),\n    UNIQUE (\"QDUJUQ\", \"YXWGWJ\"),\n    FOREIGN KEY (\"QDUJUQ\") REFERENCES \"AYZFWN\"(\"QDUJUQ\"),\n    FOREIGN KEY (\"YXWGWJ\") REFERENCES \"DCMDLL\"(\"YXWGWJ\")\n);\nCREATE TABLE \"RDMCRJ\" (\n    \"PZNGDD\" INT,\n    \"YXWGWJ\" INT NOT NULL,\n    \"RYIYUK\" INT NOT NULL,\n    \"VNLNNO\" INT NOT NULL,\n    \"XBVUUD\" INT NOT NULL,\n    \"BMXKZD\" TEXT NOT NULL,\n    PRIMARY KEY (\"PZNGDD\"),\n    FOREIGN KEY (\"YXWGWJ\") REFERENCES \"DCMDLL\"(\"YXWGWJ\"),\n    FOREIGN KEY (\"RYIYUK\") REFERENCES \"NHOSIZ\"(\"RYIYUK\")\n);",
