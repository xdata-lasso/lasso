    "ddl_postgres": "/* Relational schema for ManyMutantsBM benchmark suite. */ /* Universal schema compatible with SQLite, PostgreSQL, and MySQL. */ CREATE TABLE departments (dept_id INT PRIMARY KEY, dept_name VARCHAR(100) NOT NULL UNIQUE, location VARCHAR(100) NOT NULL);\nCREATE TABLE employees (employee_id INT PRIMARY KEY, name VARCHAR(100) NOT NULL, dept_id INT NOT NULL, title VARCHAR(50) NOT NULL, is_active INT NOT NULL DEFAULT 1, FOREIGN KEY (dept_id) REFERENCES departments (dept_id));\nCREATE TABLE projects (project_id INT PRIMARY KEY, project_name VARCHAR(100) NOT NULL UNIQUE, dept_id INT NOT NULL, budget REAL NOT NULL, status VARCHAR(20) NOT NULL, FOREIGN KEY (dept_id) REFERENCES departments (dept_id));\nCREATE TABLE assignments (assignment_id INT PRIMARY KEY, employee_id INT NOT NULL, project_id INT NOT NULL, assigned_date VARCHAR(20) NOT NULL, hourly_rate REAL NOT NULL, UNIQUE (employee_id, project_id), FOREIGN KEY (employee_id) REFERENCES employees (employee_id), FOREIGN KEY (project_id) REFERENCES projects (project_id));\nCREATE TABLE tasks (task_id INT PRIMARY KEY, project_id INT NOT NULL, assigned_to INT, title VARCHAR(200) NOT NULL, priority VARCHAR(20) NOT NULL, status VARCHAR(20) NOT NULL, due_date VARCHAR(20) NOT NULL, FOREIGN KEY (project_id) REFERENCES projects (project_id), FOREIGN KEY (assigned_to) REFERENCES employees (employee_id));\nCREATE TABLE customers (customer_id INT PRIMARY KEY, customer_name VARCHAR(100) NOT NULL, tier VARCHAR(20) NOT NULL, is_active INT NOT NULL DEFAULT 1);\nCREATE TABLE orders (order_id INT PRIMARY KEY, customer_id INT NOT NULL, order_date VARCHAR(20) NOT NULL, order_status VARCHAR(20) NOT NULL, order_priority VARCHAR(20) NOT NULL DEFAULT 'STANDARD', total_amount REAL NOT NULL DEFAULT 0, FOREIGN KEY (customer_id) REFERENCES customers (customer_id));\nCREATE TABLE categories (category_id INT PRIMARY KEY, category_name VARCHAR(100) NOT NULL UNIQUE, department VARCHAR(50) NOT NULL);\nCREATE TABLE products (product_id INT PRIMARY KEY, category_id INT NOT NULL, product_name VARCHAR(100) NOT NULL, list_price REAL NOT NULL, is_discontinued INT NOT NULL DEFAULT 0, FOREIGN KEY (category_id) REFERENCES categories (category_id));\nCREATE TABLE order_items (item_id INT PRIMARY KEY, order_id INT NOT NULL, product_id INT NOT NULL, quantity INT NOT NULL, unit_price REAL NOT NULL, discount_rate REAL, UNIQUE (order_id, product_id), FOREIGN KEY (order_id) REFERENCES orders (order_id), FOREIGN KEY (product_id) REFERENCES products (product_id));\nCREATE TABLE reviews (review_id INT PRIMARY KEY, product_id INT NOT NULL, customer_id INT NOT NULL, rating INT NOT NULL, is_verified INT NOT NULL DEFAULT 0, review_date VARCHAR(20) NOT NULL, FOREIGN KEY (product_id) REFERENCES products (product_id), FOREIGN KEY (customer_id) REFERENCES customers (customer_id));",
